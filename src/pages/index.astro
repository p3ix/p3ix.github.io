---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Avatar from '@/components/Avatar.astro';
import Icon from '@/components/Icon.astro';
import Prompt from '@/components/Prompt.astro';
import TerminalWindow from '@/components/TerminalWindow.astro';
import { Image } from 'astro:assets';
import {
  education,
  experience,
  languages,
  platforms,
  profile,
  skills,
  socials,
  tools,
  type StackItem,
} from '@/data/profile';
import { certHref, certs } from '@/lib/certs';
import { getCommands, getPublished } from '@/lib/content';
import { formatDate } from '@/lib/format';
import { SEVERITY_IDS, severities } from '@/lib/taxonomy';
import { tone } from '@/lib/tone';

// El botón del CV solo aparece si existe src/assets/cv.pdf (la versión sin teléfono).
const cvFiles = import.meta.glob<string>('/src/assets/cv.pdf', { query: '?url', import: 'default', eager: true });
const cvUrl = Object.values(cvFiles)[0];
const github = socials.find((s) => s.icon === 'github');
const linkedin = socials.find((s) => s.icon === 'linkedin');

// Stack: cada herramienta con comandos en la biblia enlaza a ellos en el buscador.
const commands = await getCommands();
const normalize = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
const commandsByFile = Map.groupBy(commands, (c) => normalize(c.file));
const bibleTools = new Set(commands.map((c) => c.file)).size;

function stackChip(item: StackItem) {
  const name = typeof item === 'string' ? item : item.name;
  const list = commandsByFile.get(normalize(typeof item === 'string' ? item : item.bible));
  if (!list) {
    if (typeof item !== 'string') throw new Error(`Stack de profile.ts: "${item.bible}" no es ningún archivo de src/content/commands/.`);
    return { name };
  }
  return { name, count: list.length, href: `/biblia/comandos/?q=${encodeURIComponent(list[0].tool)}` };
}

const stack = skills.map((g) => ({ ...g, chips: g.items.map(stackChip) }));

// Acceso a los reportes bajo el hall of fame: cuántos hay y de qué severidad (de más a menos grave).
const reports = await getPublished('bugbounty');
const severityCounts = [...SEVERITY_IDS]
  .reverse()
  .map((id) => ({ ...severities[id], count: reports.filter((r) => r.data.severity === id).length }))
  .filter((s) => s.count > 0);

const description = `${profile.name} (${profile.handle}): ${profile.role}. Experiencia, formación, certificaciones, hall of fame y herramientas.`;
---

<BaseLayout description={description} section="whoami" path={['whoami']} ogImage="/og/whoami.png">
  <TerminalWindow title="p3i@kali: ~" label="Perfil">
    <Prompt>whoami</Prompt>
    <div class="flex flex-wrap items-center gap-8">
      <Avatar size="lg" />
      <div class="flex min-w-[260px] flex-1 flex-col gap-3">
        <h1 class="font-mono text-[34px] leading-tight font-extrabold tracking-tight text-brand text-glow-soft">{profile.name}</h1>
        <p class="font-mono text-sm text-fg-strong">@{profile.handle} · {profile.role}</p>
        <p class="inline-flex items-center gap-2 font-mono text-[13px] text-subtle">
          <Icon name="pin" size={15} />
          {profile.location}
        </p>
        <div aria-hidden="true" class="h-0.5 bg-spectrum"></div>
        <p class="text-[17px] leading-[1.7] text-fg">{profile.bio}</p>
        <div class="flex flex-wrap gap-3 pt-1">
          {
            github && (
              <a href={github.href} target="_blank" rel="me noopener" class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-line-strong px-4 font-mono text-sm text-fg-strong hover:border-brand/45 hover:text-brand">
                <Icon name="github" size={17} />
                GitHub
              </a>
            )
          }
          {
            linkedin && (
              <a href={linkedin.href} target="_blank" rel="me noopener" class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-line-strong px-4 font-mono text-sm text-fg-strong hover:border-brand/45 hover:text-brand">
                <Icon name="linkedin" size={17} />
                LinkedIn
              </a>
            )
          }
          {
            cvUrl && (
              <a href={cvUrl} download="cv-asier-lara.pdf" class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-brand px-4 font-mono text-sm font-bold text-on-accent">
                <Icon name="download" size={17} />
                CV en PDF
              </a>
            )
          }
        </div>
      </div>
    </div>
  </TerminalWindow>

  <div class="grid gap-7 lg:grid-cols-2">
    <section aria-labelledby="exp-title" class="flex flex-col gap-4 rounded-2xl border border-line bg-panel/80 p-5 sm:p-6" style={tone('whoami')}>
      <h2 id="exp-title" class="inline-flex items-center gap-2.5 font-mono text-xl font-bold text-fg-strong">
        <Icon name="briefcase" size={20} class="tone-text" />
        Experiencia
      </h2>
      <ol class="flex flex-col gap-5 border-l border-line pl-6">
        {
          experience.map((e, i) => (
            <li class="relative">
              <span aria-hidden="true" class:list={['absolute top-1.5 -left-[29px] size-2.5 rounded-full ring-4 ring-panel', i === 0 ? 'tone-pill' : 'bg-line-strong']} />
              <p class="font-mono text-xs text-subtle">{e.period} · {e.place}</p>
              <p class="font-semibold text-fg-strong">{e.role} <span class="font-normal text-muted">· {e.org}</span></p>
              {
                e.points.length > 0 && (
                  <ul class="mt-2 flex flex-col gap-1.5 text-[15px] leading-relaxed text-muted">
                    {e.points.map((pt) => (
                      <li class="flex gap-2">
                        <span class="tone-text">▹</span>
                        {pt}
                      </li>
                    ))}
                  </ul>
                )
              }
            </li>
          ))
        }
      </ol>
    </section>

    <div class="flex flex-col gap-7">
      <section aria-labelledby="edu-title" class="flex flex-col gap-4 rounded-2xl border border-line bg-panel/80 p-5 sm:p-6" style={tone('whoami')}>
        <h2 id="edu-title" class="inline-flex items-center gap-2.5 font-mono text-xl font-bold text-fg-strong">
          <Icon name="cap" size={20} class="tone-text" />
          Formación
        </h2>
        <ol class="flex flex-col gap-4 border-l border-line pl-6">
          {
            education.map((e, i) => (
              <li class="relative">
                <span aria-hidden="true" class:list={['absolute top-1.5 -left-[29px] size-2.5 rounded-full ring-4 ring-panel', i === 0 ? 'tone-pill' : 'bg-line-strong']} />
                <p class="font-semibold text-fg-strong">{e.title}</p>
                <p class="font-mono text-xs text-subtle">{[e.org, e.period].filter(Boolean).join(' · ')}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="cert-title" class="flex flex-col gap-4 rounded-2xl border border-line bg-panel/80 p-5 sm:p-6" style={tone('certs')}>
        <h2 id="cert-title" class="inline-flex items-center gap-2.5 font-mono text-xl font-bold text-fg-strong">
          <Icon name="badge" size={20} class="tone-text" />
          Certificaciones
        </h2>
        <ul class="flex flex-col gap-4">
          {
            certs.map((c) => (
              <li class="flex items-center gap-4">
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                    <span class="tone-text font-mono text-lg font-extrabold">{c.name}</span>
                    <span class="inline-flex items-center gap-1 rounded-full border border-ctf/40 bg-ctf/10 px-2 py-0.5 font-mono text-[11px] text-ctf">
                      <Icon name="check" size={12} strokeWidth={2.6} />
                      obtenida
                    </span>
                  </p>
                  <p class="text-[15px] text-muted">{c.full}</p>
                  <p class="font-mono text-xs text-subtle">{[c.issuer, c.awarded && formatDate(c.awarded)].filter(Boolean).join(' · ')}</p>
                </div>
                {c.image && (
                  <a
                    href={certHref(c)}
                    aria-label={`Ver el certificado ${c.name}`}
                    class="tone-border group relative block w-24 shrink-0 overflow-hidden rounded-lg border shadow-[0_10px_24px_-14px_rgb(0_0_0/0.9)] transition-transform hover:-translate-y-0.5 sm:w-32"
                  >
                    <Image src={c.image} alt="" widths={[192, 384]} sizes="(min-width: 640px) 128px, 96px" class="block h-auto w-full" />
                    <span aria-hidden="true" class="tone-text absolute inset-0 grid place-items-center bg-base/65 opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
                      <Icon name="expand" size={20} strokeWidth={2.2} />
                    </span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
        <a href="/certificados/" class="tone-text mt-auto inline-flex min-h-11 items-center gap-1.5 self-start font-mono text-sm hover:underline">
          Ver certificados
          <Icon name="arrow-right" size={15} />
        </a>
      </section>
    </div>
  </div>

  <section aria-labelledby="hof-title" class="flex flex-col gap-4" style={tone('bb')}>
    <h2 id="hof-title" class="font-mono text-xl font-bold text-fg-strong"><span class="tone-text">##</span> Hall of fame</h2>
    <ul class="grid gap-3.5 md:grid-cols-3">
      {
        platforms.map((p) => (
          <li class="grid">
            <a href={p.url} target="_blank" rel="noopener" class="tone-border tone-faint group flex flex-col gap-2 rounded-2xl border p-5 transition-transform hover:-translate-y-0.5">
              <span class="flex items-center justify-between gap-3">
                <span class="text-lg font-semibold text-fg-strong">{p.name}</span>
                <Icon name="external" size={15} class="tone-text opacity-70 group-hover:opacity-100" />
              </span>
              <span class="tone-text font-mono text-xs">@{p.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>
    {
      reports.length > 0 && (
        <a
          href="/bugbounty/"
          aria-label={`Ver los reportes divulgados: ${reports.length} en total, ${severityCounts.map((s) => `${s.count} ${s.label}`).join(', ')}`}
          class="tone-border group flex flex-wrap items-center gap-x-5 gap-y-4 rounded-2xl border bg-[linear-gradient(100deg,color-mix(in_oklab,var(--color-bb)_14%,transparent),transparent_70%)] px-5 py-4.5 transition-[translate,border-color] hover:-translate-y-0.5 hover:border-bb/60 sm:px-6"
        >
          <span class="tone-soft tone-text grid size-12 shrink-0 place-items-center rounded-xl border border-bb/35">
            <Icon name="trophy" size={24} strokeWidth={2.1} />
          </span>
          <span class="flex min-w-0 flex-[1_1_240px] flex-col gap-1.5">
            <span class="font-mono text-lg font-bold text-fg-strong">Reportes divulgados</span>
            <span class="text-[15px] text-muted">
              {reports.length} {reports.length === 1 ? 'hallazgo real publicado' : 'hallazgos reales publicados'} con permiso del programa
            </span>
            <span class="flex flex-wrap gap-1.5 pt-0.5">
              {severityCounts.map((s) => (
                <span style={tone(s.color)} class="tone-soft tone-text rounded-md px-2 py-0.5 font-mono text-[11px] font-bold tracking-wider uppercase">
                  {s.count} {s.label}
                </span>
              ))}
            </span>
          </span>
          <span class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-bb px-4.5 font-mono text-sm font-bold text-on-accent max-sm:w-full">
            Ver reportes
            <Icon name="arrow-right" size={17} strokeWidth={2.4} class="transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      )
    }
  </section>

  <section aria-labelledby="tools-title" class="flex flex-col gap-4" style={tone('tools')}>
    <h2 id="tools-title" class="font-mono text-xl font-bold text-fg-strong"><span class="tone-text">##</span> Herramientas propias</h2>
    <ul class="grid gap-3.5 md:grid-cols-3">
      {
        tools.map((t) => (
          <li class="grid">
            <a href={`/herramientas/#${t.name}`} class="tone-border group flex flex-col gap-2 rounded-2xl border bg-panel/90 p-5 transition-transform hover:-translate-y-0.5">
              <span class="tone-text inline-flex items-center gap-2 font-mono text-base font-bold">
                <Icon name="wrench" size={16} />
                {t.name}
              </span>
              <span class="text-[15px] leading-relaxed text-muted">{t.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="flex flex-wrap gap-x-6 gap-y-1 font-mono text-sm">
      <a href="/herramientas/" class="inline-flex min-h-11 items-center text-tools hover:underline">Todas las herramientas →</a>
      {github && <a href={github.href} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-subtle hover:text-tools">Código en github.com/p3ix</a>}
    </p>
  </section>

  <section aria-labelledby="stack-title" class="flex flex-col gap-4">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 id="stack-title" class="font-mono text-xl font-bold text-fg-strong"><span class="text-brand">##</span> Stack</h2>
      <a href="/biblia/comandos/" class="inline-flex min-h-11 items-center font-mono text-sm text-biblia hover:underline">
        {commands.length} comandos de {bibleTools} herramientas en la biblia →
      </a>
    </div>
    <p class="-mt-2 text-[15px] text-muted">Las que llevan número tienen sus comandos en la biblia: pulsa para verlos.</p>
    <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
      {
        stack.map((g) => (
          <div style={tone(g.color)} class="tone-border flex flex-col gap-3 rounded-2xl border bg-panel/90 p-4">
            <p class="tone-text font-mono text-xs font-bold tracking-[0.16em] uppercase">{g.area}</p>
            <ul class="flex flex-wrap gap-2">
              {g.chips.map((chip) => (
                <li class="flex">
                  {chip.href ? (
                    <a
                      href={chip.href}
                      aria-label={`${chip.name}: ${chip.count} ${chip.count === 1 ? 'comando' : 'comandos'} en la biblia`}
                      class="tone-soft inline-flex min-h-7 items-center gap-1.5 rounded-md border border-transparent px-2 font-mono text-[13px] text-fg-strong transition-colors hover:tone-border"
                    >
                      {chip.name}
                      <span class="tone-text text-[11px] font-bold">{chip.count}</span>
                    </a>
                  ) : (
                    <span class="tone-faint inline-flex min-h-7 items-center rounded-md border border-line px-2 font-mono text-[13px] text-fg">{chip.name}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="lang-title" class="flex flex-col gap-4">
    <h2 id="lang-title" class="inline-flex items-center gap-2.5 font-mono text-xl font-bold text-fg-strong">
      <Icon name="globe" size={20} class="text-whoami" />
      Idiomas
    </h2>
    <ul class="flex flex-wrap gap-3">
      {
        languages.map((l) => (
          <li class="flex items-center gap-3 rounded-xl border border-line-strong bg-panel/90 px-4 py-2.5">
            <span class="text-fg-strong">{l.name}</span>
            <span class="rounded-md bg-whoami/15 px-2 py-0.5 font-mono text-xs text-whoami">{l.level}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
