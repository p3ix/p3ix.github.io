---
// Muestra los tokens de color de global.css. Solo para la página /kit.
const groups: { title: string; tokens: string[] }[] = [
  { title: 'Superficies', tokens: ['base', 'sidebar', 'panel', 'code', 'line', 'line-strong'] },
  { title: 'Texto', tokens: ['fg-strong', 'fg', 'muted', 'subtle'] },
  { title: 'Secciones', tokens: ['home', 'ctf', 'bb', 'biblia', 'tools', 'whoami', 'tags'] },
  {
    title: 'Áreas de la biblia',
    tokens: ['area-recon', 'area-web', 'area-ad', 'area-crack', 'area-shell', 'area-lpe', 'area-wpe', 'area-pivot'],
  },
  {
    title: 'Variables',
    tokens: [
      'var-rhost',
      'var-dcip',
      'var-subnet',
      'var-ports',
      'var-lhost',
      'var-lport',
      'var-iface',
      'var-domain',
      'var-user',
      'var-pass',
      'var-hash',
      'var-url',
      'var-wordlist',
    ],
  },
];
---

<!-- Sin ul/li/h3/code a propósito: así no heredan los estilos de .prose-p3i. -->
<div class="flex flex-col gap-6">
  {
    groups.map((g) => (
      <div class="flex flex-col gap-3">
        <p class="font-mono text-xs tracking-[0.2em] text-subtle uppercase">{g.title}</p>
        <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-4">
          {g.tokens.map((t) => (
            <div class="flex items-center gap-3 rounded-xl border border-line bg-panel p-2">
              <span
                class="size-11 shrink-0 rounded-lg border border-line-strong"
                style={`background: var(--color-${t})`}
              />
              <span class="font-mono text-xs text-muted">{t}</span>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>
