---
interface Props {
  title?: string;
  /** Etiqueta accesible de la sección. */
  label?: string;
  class?: string;
}

const { title = 'p3i@kali: ~', label, class: className } = Astro.props;
---

<section
  aria-label={label}
  class:list={[
    'overflow-hidden rounded-2xl border border-brand/28 bg-panel/95 shadow-[0_0_60px_color-mix(in_oklab,var(--color-brand)_8%,transparent)]',
    className,
  ]}
>
  <div class="relative flex items-center justify-center border-b border-line px-4 py-3 font-mono text-[13px] text-subtle">
    <span aria-hidden="true" class="absolute top-1/2 left-4 flex -translate-y-1/2 gap-2">
      <span class="size-3 rounded-full bg-dot-close"></span>
      <span class="size-3 rounded-full bg-dot-min"></span>
      <span class="size-3 rounded-full bg-dot-max"></span>
    </span>
    <span>{title}</span>
  </div>
  <div class="flex flex-col gap-5.5 p-5 sm:p-6.5">
    <slot />
  </div>
</section>
