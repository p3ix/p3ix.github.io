---
import { Image } from 'astro:assets';
import { profile } from '@/data/profile';

interface Props {
  size?: 'md' | 'lg';
}

const { size = 'md' } = Astro.props;
const large = size === 'lg';

// La foto de la sidebar y del whoami: src/assets/avatar.(png|jpg|jpeg|webp); sin ella, la firma "p3i".
const found = import.meta.glob<{ default: ImageMetadata }>('/src/assets/avatar.{png,jpg,jpeg,webp}', { eager: true });
const avatar = Object.values(found)[0]?.default;
const alt = `Foto de ${profile.name}`;
---

<div
  class:list={[
    'shrink-0 overflow-hidden rounded-full border border-line-strong',
    large ? 'size-[168px]' : 'size-[124px]',
  ]}
>
  <div
    class="grid size-full place-items-center overflow-hidden rounded-full bg-[radial-gradient(circle_at_50%_40%,var(--color-panel),var(--color-base)_70%)]"
  >
    {
      avatar ? (
        <Image src={avatar} alt={alt} width={large ? 336 : 248} height={large ? 336 : 248} class="size-full object-cover" />
      ) : (
        <span aria-label="p3i" role="img" class:list={['-rotate-8 font-tag leading-none text-brand text-glow', large ? 'text-[70px]' : 'text-[52px]']}>
          p3i
        </span>
      )
    }
  </div>
</div>
