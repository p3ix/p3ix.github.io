---
// Vitrina del trofeo de un reporte (tarjeta de recompensa, carta de agradecimiento, certificado...):
// tarjeta inclinada en 3D con halo y brillo holográfico. Al pulsarla se abre a tamaño completo.
// Los estilos están en global.css (.trophy-*).
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { tone, type ColorToken } from '@/lib/tone';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Pie de la vitrina, p. ej. "Recompensa · YesWeHack". */
  caption: string;
  /** Token del color del borde y el brillo. */
  color?: ColorToken;
}

const { src, alt, caption, color = 'bb' } = Astro.props;
const full = await getImage({ src, width: Math.min(src.width, 1600) });
const widths = [480, 960];
const sizes = '(min-width: 640px) 440px, calc(100vw - 4.5rem)';
---

<figure data-trophy style={tone(color)} class="flex flex-col items-center gap-3">
  <a href={full.src} data-trophy-open class="trophy-stage relative block w-full max-w-[440px] cursor-zoom-in rounded-[0.9rem] p-2">
    <Image src={src} alt="" aria-hidden="true" widths={widths} sizes={sizes} class="trophy-ambient" />
    <span data-trophy-card class="trophy-card">
      <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="eager" class="block h-auto w-full" />
      <span aria-hidden="true" class="trophy-foil"></span>
      <span aria-hidden="true" class="trophy-shine"></span>
    </span>
    <span class="sr-only">(ampliar)</span>
  </a>
  <figcaption class="flex items-center gap-2 font-mono text-xs tracking-[0.16em] text-subtle uppercase">
    <Icon name="trophy" size={14} class="tone-text" />
    {caption}
  </figcaption>

  <dialog
    data-trophy-dialog
    data-pagefind-ignore
    aria-label={alt}
    class="tone-border m-auto w-[min(1200px,calc(100vw-2rem))] overflow-hidden rounded-2xl border bg-panel p-0 shadow-[0_0_80px_color-mix(in_oklab,var(--tone)_18%,transparent)] backdrop:bg-base/85 backdrop:backdrop-blur-sm"
  >
    <form method="dialog" class="absolute top-3 right-3">
      <button type="submit" aria-label="Cerrar" class="grid size-11 place-items-center rounded-full border border-line-strong bg-code/85 text-fg-strong hover:text-brand">
        <Icon name="close" size={18} />
      </button>
    </form>
    <img src={full.src} width={full.attributes.width} height={full.attributes.height} alt={alt} loading="lazy" decoding="async" class="block h-auto w-full" />
  </dialog>
</figure>

<script>
  // Con ratón (y sin reducir movimiento) la tarjeta se inclina hacia el puntero y la luz lo sigue.
  const canTilt = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');

  document.querySelectorAll<HTMLElement>('[data-trophy]').forEach((trophy) => {
    const stage = trophy.querySelector<HTMLAnchorElement>('[data-trophy-open]');
    const card = trophy.querySelector<HTMLElement>('[data-trophy-card]');
    const dialog = trophy.querySelector<HTMLDialogElement>('[data-trophy-dialog]');
    if (!stage || !card || !dialog) return;

    stage.addEventListener('click', (event) => {
      // Ctrl/Cmd+clic abre la imagen en otra pestaña, como cualquier enlace.
      if (event.ctrlKey || event.metaKey || event.shiftKey) return;
      event.preventDefault();
      dialog.showModal();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    stage.addEventListener('pointermove', (event) => {
      if (!canTilt.matches) return;
      const r = stage.getBoundingClientRect();
      const x = (event.clientX - r.left) / r.width;
      const y = (event.clientY - r.top) / r.height;
      card.classList.add('is-tracking');
      card.style.setProperty('--rx', `${((0.5 - y) * 14).toFixed(2)}deg`);
      card.style.setProperty('--ry', `${((x - 0.5) * 20).toFixed(2)}deg`);
      card.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`);
      card.style.setProperty('--my', `${(y * 100).toFixed(1)}%`);
    });
    stage.addEventListener('pointerleave', () => {
      card.classList.remove('is-tracking');
      for (const prop of ['--rx', '--ry', '--mx', '--my']) card.style.removeProperty(prop);
    });
  });
</script>
