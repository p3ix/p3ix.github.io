---
// Paleta de búsqueda global (Ctrl+K o /). La lógica está en src/scripts/palette.ts.
import Icon from './Icon.astro';
---

<dialog
  data-palette
  aria-label="Buscar en p3i"
  class="mx-auto mt-[10vh] mb-auto w-[min(660px,calc(100vw-2rem))] overflow-hidden rounded-2xl border border-brand/30 bg-panel p-0 text-fg shadow-[0_0_80px_color-mix(in_oklab,var(--color-brand)_14%,transparent)] backdrop:bg-base/75 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <Icon name="search" size={18} class="shrink-0 text-brand" />
    <input
      data-palette-input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-results"
      aria-autocomplete="list"
      aria-label="Buscar comandos, writeups y notas"
      placeholder="Busca comandos, máquinas, notas…"
      spellcheck="false"
      autocomplete="off"
      class="h-14 min-w-0 flex-1 bg-transparent font-mono text-[15px] text-fg-strong outline-none placeholder:text-subtle"
    />
    <kbd class="rounded border border-line-strong px-1.5 py-0.5 font-mono text-[11px] text-subtle">Esc</kbd>
  </div>
  <div class="max-h-[min(60vh,520px)] overflow-y-auto p-2" data-palette-scroll>
    <ul id="palette-results" role="listbox" aria-label="Resultados" data-palette-results class="flex flex-col gap-0.5"></ul>
    <p data-palette-status class="px-4 py-8 text-center font-mono text-sm text-subtle" hidden></p>
  </div>
  <footer class="flex flex-wrap gap-x-5 gap-y-1 border-t border-line px-4 py-2.5 font-mono text-[11px] text-subtle">
    <span><kbd class="text-muted">↑↓</kbd> moverse</span>
    <span><kbd class="text-muted">Enter</kbd> copiar comando o abrir página</span>
    <span><kbd class="text-muted">Ctrl+Enter</kbd> ver el comando en la biblia</span>
  </footer>
</dialog>

<div
  data-toast
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed bottom-6 left-1/2 z-[70] -translate-x-1/2 rounded-xl border border-ctf/50 bg-panel px-4 py-2.5 font-mono text-sm text-fg-strong opacity-0 shadow-lg transition-opacity data-shown:opacity-100"
>
</div>
